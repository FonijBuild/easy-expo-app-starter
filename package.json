{
  "name": "easy-starter-react-native-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "dev": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm validate:env && pnpm validate:architecture && pnpm theme:check && pnpm typecheck && pnpm lint && pnpm test && pnpm format:check && pnpm deps:check",
    "validate:env": "tsx scripts/validate-env.ts",
    "generate:feature": "tsx scripts/generate-feature.ts",
    "generate:screen": "tsx scripts/generate-screen.ts",
    "theme:sync": "tsx scripts/generate-theme.ts",
    "theme:check": "tsx scripts/generate-theme.ts --check",
    "postinstall": "tsx scripts/generate-theme.ts",
    "build:web": "expo export --platform web",
    "doctor": "npx expo-doctor@latest",
    "validate:architecture": "tsx scripts/validate-architecture.ts",
    "deps:check": "expo install --check"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@gluestack-ui/core": "^5.0.15",
    "@gluestack-ui/utils": "^5.0.6",
    "@hookform/resolvers": "^5.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.101.2",
    "buffer": "^6.0.3",
    "expo": "~57.0.10",
    "expo-constants": "~57.0.8",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "i18next": "^26.3.6",
    "nativewind": "preview",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.82.0",
    "react-i18next": "^17.0.10",
    "react-native": "0.86.2",
    "react-native-css": "3.0.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.3.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10",
    "lightningcss": "1.30.1"
  }
}
